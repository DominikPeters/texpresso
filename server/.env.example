# TeXpresso WebSocket Server Configuration
# Copy this file to .env and adjust values as needed

# Server port
PORT=8080

# Path to TeXpresso executable
TEXPRESSO_PATH=../build/texpresso

# Working directory for TeXpresso processes
# WORKING_DIR=/path/to/working/dir

# Forward TeXpresso stderr output to clients as log messages
FORWARD_STDERR=false

# Maximum concurrent connections
MAX_CONNECTIONS=100

# Connection timeout in milliseconds (0 = disabled)
CONNECTION_TIMEOUT=0

# Enable verbose logging (shows all incoming/outgoing messages)
VERBOSE=false
